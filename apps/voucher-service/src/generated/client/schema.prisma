datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Voucher {
  id                String         @id @default(uuid())
  code              String         @unique
  type              String // PERCENTAGE, FIXED_AMOUNT
  value             Decimal        @db.Decimal(12, 2)
  minPurchase       Decimal        @default(0) @map("min_purchase") @db.Decimal(12, 2)
  maxDiscount       Decimal?       @map("max_discount") @db.Decimal(12, 2)
  usageLimit        Int?           @map("usage_limit")
  usageLimitPerUser Int            @default(1) @map("usage_limit_per_user")
  usedCount         Int            @default(0) @map("used_count")
  scope             String         @default("ALL") // ALL, CATEGORY, SELLER
  scopeReferenceId  String?        @map("scope_reference_id")
  startsAt          DateTime       @map("starts_at")
  endsAt            DateTime       @map("ends_at")
  status            String         @default("ACTIVE") // ACTIVE, INACTIVE, EXPIRED
  createdBy         String         @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  usages            VoucherUsage[]

  @@map("vouchers")
}

model VoucherUsage {
  id             String   @id @default(uuid())
  voucherId      String   @map("voucher_id")
  voucher        Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  orderId        String   @map("order_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  usedAt         DateTime @default(now()) @map("used_at")

  @@map("voucher_usages")
}
