datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Notification {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  type      String // ORDER_CREATED, PAYMENT_SUCCESS, PAYMENT_FAILED, ORDER_SHIPPED, ORDER_DELIVERED, LOW_STOCK, REVIEW_RECEIVED, SYSTEM
  title     String
  message   String
  data      Json? // Metadata e.g. { orderId, productId }
  channel   String     @default("IN_APP") // IN_APP, EMAIL, BOTH
  isRead    Boolean    @default(false) @map("is_read")
  readAt    DateTime?  @map("read_at")
  createdAt DateTime   @default(now()) @map("created_at")
  emails    EmailLog[]

  @@map("notifications")
}

model EmailLog {
  id             String        @id @default(uuid())
  notificationId String?       @map("notification_id")
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  to             String
  subject        String
  templateName   String        @map("template_name")
  templateData   Json          @map("template_data")
  status         String        @default("PENDING") // PENDING, SENT, FAILED
  sentAt         DateTime?     @map("sent_at")
  failedAt       DateTime?     @map("failed_at")
  error          String?
  retryCount     Int           @default(0) @map("retry_count")
  maxRetries     Int           @default(3) @map("max_retries")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("email_logs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String   @map("html_body")
  textBody  String?  @map("text_body")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}
