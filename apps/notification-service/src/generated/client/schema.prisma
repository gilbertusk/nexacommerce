datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Notification {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  sourceEventId String?    @unique @map("source_event_id")
  type          String // ORDER_CREATED, PAYMENT_SUCCESS, PAYMENT_FAILED, ORDER_SHIPPED, ORDER_DELIVERED, LOW_STOCK, REVIEW_RECEIVED, SYSTEM
  title         String
  message       String
  data          Json? // Metadata e.g. { orderId, productId }
  channel       String     @default("IN_APP") // IN_APP, EMAIL, BOTH
  isRead        Boolean    @default(false) @map("is_read")
  readAt        DateTime?  @map("read_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  emails        EmailLog[]

  @@map("notifications")
}

model EmailLog {
  id             String        @id @default(uuid())
  notificationId String?       @map("notification_id")
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  to             String
  subject        String
  templateName   String        @map("template_name")
  templateData   Json          @map("template_data")
  status         String        @default("PENDING") // PENDING, SENT, FAILED
  sentAt         DateTime?     @map("sent_at")
  failedAt       DateTime?     @map("failed_at")
  error          String?
  retryCount     Int           @default(0) @map("retry_count")
  maxRetries     Int           @default(3) @map("max_retries")
  createdAt      DateTime      @default(now()) @map("created_at")

  /// Dispatcher claim fields. A PENDING row is a durable instruction to send
  /// this email; it is written in the same transaction as the notification it
  /// belongs to, so a crash before delivery leaves work to resume rather than
  /// a silently dropped message.
  availableAt DateTime  @default(now()) @map("available_at")
  lockedAt    DateTime? @map("locked_at")
  lockToken   String?   @map("lock_token")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@map("email_logs")
}

/// Consumption record for one broker event as seen by one named consumer.
/// Reaches PROCESSED in the same transaction as the notification rows and
/// email jobs it produced.
model InboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  consumer    String
  eventName   String    @map("event_name")
  payload     Json
  status      String    @default("PROCESSING")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(1000)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, consumer])
  @@index([consumer, status])
  @@map("inbox_events")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String   @map("html_body")
  textBody  String?  @map("text_body")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}
