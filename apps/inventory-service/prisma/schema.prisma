datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Inventory {
  id                String             @id @default(uuid())
  productId         String             @unique @map("product_id")
  sku               String?
  currentStock      Int                @default(0) @map("current_stock")
  reservedStock     Int                @default(0) @map("reserved_stock")
  availableStock    Int                @default(0) @map("available_stock")
  lowStockThreshold Int                @default(10) @map("low_stock_threshold")
  warehouseId       String?            @map("warehouse_id")
  movements         StockMovement[]
  reservations      StockReservation[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("inventories")
}

model StockMovement {
  id            String    @id @default(uuid())
  inventoryId   String    @map("inventory_id")
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  type          String // IN, OUT, ADJUSTMENT, RESERVE, CONFIRM, RELEASE
  quantity      Int // positive/negative
  referenceType String?   @map("reference_type") // ORDER, MANUAL, SYSTEM
  referenceId   String?   @map("reference_id")
  note          String?
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("stock_movements")
}

model StockReservation {
  id          String    @id @default(uuid())
  inventoryId String    @map("inventory_id")
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  orderId     String    @map("order_id")
  quantity    Int
  status      String // RESERVED, CONFIRMED, RELEASED, EXPIRED
  expiresAt   DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("stock_reservations")
}
