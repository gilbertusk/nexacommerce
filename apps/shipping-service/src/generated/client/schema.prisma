datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Courier {
  id        String          @id @default(uuid())
  name      String          @unique
  code      String          @unique
  services  Json // Array of service options: [{ code: "REG", name: "Regular", estimatedDays: "2-3" }]
  isActive  Boolean         @default(true) @map("is_active")
  createdBy String?         @map("created_by")
  updatedBy String?         @map("updated_by")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  rates     ShippingRate[]
  orders    ShippingOrder[]

  @@map("couriers")
}

model ShippingRate {
  id              String   @id @default(uuid())
  courierId       String   @map("courier_id")
  courier         Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  serviceCode     String   @map("service_code")
  weight          Int // weight in grams
  cost            Decimal  @db.Decimal(12, 2)
  estimatedDays   String   @map("estimated_days")
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([courierId, originCity, destinationCity, serviceCode, weight], map: "shipping_rates_route_service_weight_key")
  @@index([originCity, destinationCity])
  @@map("shipping_rates")
}

model ShippingOrder {
  id                 String                  @id @default(uuid())
  orderId            String                  @map("order_id")
  /// Seller whose parcel this row represents. Nullable only for rows created
  /// before split-shipment support; all new writes require it.
  sellerId           String?                 @map("seller_id")
  courierId          String                  @map("courier_id")
  courier            Courier                 @relation(fields: [courierId], references: [id])
  courierName        String                  @map("courier_name")
  serviceCode        String                  @map("service_code")
  serviceName        String                  @map("service_name")
  trackingNumber     String?                 @unique @map("tracking_number")
  originAddress      Json                    @map("origin_address") // { city, province }
  destinationAddress Json                    @map("destination_address") // { recipientName, phone, street, city, province, postalCode }
  weight             Int
  cost               Decimal                 @db.Decimal(12, 2)
  status             String                  @default("WAITING_PICKUP") // WAITING_PICKUP, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED, RETURNED
  estimatedDelivery  String?                 @map("estimated_delivery")
  notes              String?
  shippedAt          DateTime?               @map("shipped_at")
  deliveredAt        DateTime?               @map("delivered_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  history            ShippingStatusHistory[]

  @@unique([orderId, sellerId], map: "shipping_orders_order_id_seller_id_key")
  @@index([orderId])
  @@index([sellerId])
  @@map("shipping_orders")
}

model ShippingStatusHistory {
  id              String        @id @default(uuid())
  shippingOrderId String        @map("shipping_order_id")
  shippingOrder   ShippingOrder @relation(fields: [shippingOrderId], references: [id], onDelete: Cascade)
  fromStatus      String?       @map("from_status")
  toStatus        String        @map("to_status")
  location        String?
  note            String?
  updatedBy       String?       @default("SYSTEM") @map("updated_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("shipping_status_histories")
}

model OutboxEvent {
  id            String    @id
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventName     String    @map("event_name")
  routingKey    String    @map("routing_key")
  eventPayload  Json      @map("event_payload")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  lockToken     String?   @map("lock_token")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error") @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// A server-issued shipping price that checkout can trust.
///
/// The browser never supplies a shipping cost. It asks for a quote, receives an
/// opaque id, and passes that id to checkout; the Order Service resolves the id
/// back to this row. The snapshot columns record exactly what the price was
/// computed from, so revalidation at checkout can detect a changed cart,
/// address, or rate table rather than silently honouring a stale price.
model ShippingQuote {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  /// Destination snapshot: { addressId, city, province, postalCode }.
  destination Json
  /// Per-seller shipment snapshot. Each entry carries sellerId, originCity,
  /// originProvince, courierCode, serviceCode, weightGrams, cost, and the
  /// productIds and quantities the weight was derived from.
  shipments   Json
  /// Sum of the per-seller costs. This is the only figure checkout may charge.
  totalCost   Decimal   @map("total_cost") @db.Decimal(12, 2)
  /// Fingerprint of the cart the quote was computed for. Checkout recomputes it
  /// and refuses the quote when it no longer matches.
  cartHash    String    @map("cart_hash")
  status      String    @default("ACTIVE")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  consumedBy  String?   @map("consumed_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  // `consumedBy` additionally carries a partial unique index
  // (`shipping_quotes_consumed_by_key ... WHERE consumed_by IS NOT NULL`),
  // created in SQL because Prisma cannot express a partial index. It is what
  // makes "one quote prices at most one order" a database guarantee rather than
  // an application convention; do not drop it.
  @@index([customerId, status])
  @@index([expiresAt])
  @@map("shipping_quotes")
}

/// Consumption record for one broker event as seen by one named consumer.
/// Reaches PROCESSED in the same transaction as the seller labels it created,
/// so a redelivered OrderPaid is skipped instead of re-creating labels.
model InboxEvent {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  consumer    String
  eventName   String    @map("event_name")
  payload     Json
  status      String    @default("PROCESSING")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(1000)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, consumer])
  @@index([consumer, status])
  @@map("inbox_events")
}
