datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Courier {
  id        String          @id @default(uuid())
  name      String          @unique
  code      String          @unique
  services  Json            // Array of service options: [{ code: "REG", name: "Regular", estimatedDays: "2-3" }]
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  rates     ShippingRate[]
  orders    ShippingOrder[]

  @@map("couriers")
}

model ShippingRate {
  id              String   @id @default(uuid())
  courierId       String   @map("courier_id")
  courier         Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  serviceCode     String   @map("service_code")
  weight          Int      // weight in grams
  cost            Decimal  @db.Decimal(12, 2)
  estimatedDays   String   @map("estimated_days")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("shipping_rates")
}

model ShippingOrder {
  id                  String                  @id @default(uuid())
  orderId             String                  @unique @map("order_id")
  courierId           String                  @map("courier_id")
  courier             Courier                 @relation(fields: [courierId], references: [id])
  courierName         String                  @map("courier_name")
  serviceCode         String                  @map("service_code")
  serviceName         String                  @map("service_name")
  trackingNumber      String?                 @unique @map("tracking_number")
  originAddress       Json                    @map("origin_address") // { city, province }
  destinationAddress  Json                    @map("destination_address") // { recipientName, phone, street, city, province, postalCode }
  weight              Int
  cost                Decimal                 @db.Decimal(12, 2)
  status              String                  @default("WAITING_PICKUP") // WAITING_PICKUP, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED, RETURNED
  estimatedDelivery   String?                 @map("estimated_delivery")
  notes               String?
  shippedAt           DateTime?               @map("shipped_at")
  deliveredAt         DateTime?               @map("delivered_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  history             ShippingStatusHistory[]

  @@map("shipping_orders")
}

model ShippingStatusHistory {
  id              String        @id @default(uuid())
  shippingOrderId String        @map("shipping_order_id")
  shippingOrder   ShippingOrder @relation(fields: [shippingOrderId], references: [id], onDelete: Cascade)
  fromStatus      String?       @map("from_status")
  toStatus        String        @map("to_status")
  location        String?
  note            String?
  updatedBy       String?       @default("SYSTEM") @map("updated_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("shipping_status_histories")
}
