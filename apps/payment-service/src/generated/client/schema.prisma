datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Payment {
  id             String       @id @default(uuid())
  orderId        String       @unique @map("order_id")
  customerId     String       @map("customer_id")
  amount         Decimal      @db.Decimal(12, 2)
  provider       String       @default("MIDTRANS")
  method         String       @default("QRIS")
  externalId     String?      @map("external_id")
  paymentUrl     String?      @map("payment_url")
  qrisString     String?      @map("qris_string")
  status         String       @default("PENDING") // PENDING, PAID, PARTIALLY_REFUNDED, FAILED, EXPIRED, REFUNDED
  paidAt         DateTime?    @map("paid_at")
  expiredAt      DateTime?    @map("expired_at")
  failedAt       DateTime?    @map("failed_at")
  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  logs           PaymentLog[]

  @@map("payments")
}

model PaymentLog {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action     String // CREATED, STATUS_CHECK, WEBHOOK_RECEIVED, STATUS_UPDATED, REFUND_REQUESTED
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("payment_logs")
}

model PaymentWebhookLog {
  id          String    @id @default(uuid())
  provider    String
  eventKey    String    @unique @map("event_key")
  eventType   String    @map("event_type")
  rawPayload  Json      @map("raw_payload")
  signature   String?
  isValid     Boolean
  isProcessed Boolean   @default(false) @map("is_processed")
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("payment_webhook_logs")
}

model Refund {
  id          String    @id @default(uuid())
  paymentId   String    @map("payment_id")
  orderId     String    @map("order_id")
  amount      Decimal   @db.Decimal(12, 2)
  reason      String
  status      String    @default("PENDING") // PENDING, PROCESSED, FAILED
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([paymentId, status])
  @@index([orderId])
  @@map("refunds")
}

model OutboxEvent {
  id            String    @id
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventName     String    @map("event_name")
  routingKey    String    @map("routing_key")
  eventPayload  Json      @map("event_payload")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  lockToken     String?   @map("lock_token")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error") @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
