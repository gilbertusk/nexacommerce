datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique @map("order_number")
  customerId        String               @map("customer_id")
  customerName      String               @map("customer_name")
  customerEmail     String               @map("customer_email")
  subtotal          Decimal              @db.Decimal(12, 2)
  discount          Decimal              @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal              @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  grandTotal        Decimal              @map("grand_total") @db.Decimal(12, 2)
  voucherId         String?              @map("voucher_id")
  voucherCode       String?              @map("voucher_code")
  shippingAddressId String               @map("shipping_address_id")
  shippingAddress   Json                 @map("shipping_address")
  courierName       String?              @map("courier_name")
  courierService    String?              @map("courier_service")
  status            String               @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, PACKED, SHIPPED, DELIVERED, COMPLETED, CANCELLED, REFUNDED
  notes             String?
  paidAt            DateTime?            @map("paid_at")
  cancelledAt       DateTime?            @map("cancelled_at")
  completedAt       DateTime?            @map("completed_at")
  expiresAt         DateTime             @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String   @map("product_id")
  productName  String   @map("product_name")
  productImage String?  @map("product_image")
  productPrice Decimal  @map("product_price") @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(12, 2)
  sellerId     String   @map("seller_id")
  sellerName   String   @map("seller_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  changedBy  String?  @default("SYSTEM") @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("order_status_histories")
}
