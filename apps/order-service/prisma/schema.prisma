datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique @map("order_number")
  customerId        String               @map("customer_id")
  customerName      String               @map("customer_name")
  customerEmail     String               @map("customer_email")
  subtotal          Decimal              @db.Decimal(12, 2)
  discount          Decimal              @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal              @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  grandTotal        Decimal              @map("grand_total") @db.Decimal(12, 2)
  voucherId         String?              @map("voucher_id")
  voucherCode       String?              @map("voucher_code")
  shippingAddressId String               @map("shipping_address_id")
  shippingAddress   Json                 @map("shipping_address")
  courierName       String?              @map("courier_name")
  courierService    String?              @map("courier_service")

  /// The server-issued quote this order's shipping price came from, and the
  /// per-seller split-shipment breakdown it contained. The breakdown is the
  /// source of truth for a multi-seller order; `courierName`/`courierService`
  /// hold the first shipment only, for existing single-courier reads.
  shippingQuoteId   String?              @unique @map("shipping_quote_id")
  shipmentBreakdown Json?                @map("shipment_breakdown")
  status            String               @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, PACKED, SHIPPED, DELIVERED, COMPLETED, CANCELLED, RETURN_REQUESTED, RETURN_APPROVED, PARTIALLY_REFUNDED, REFUNDED
  notes             String?
  paidAt            DateTime?            @map("paid_at")
  cancelledAt       DateTime?            @map("cancelled_at")
  completedAt       DateTime?            @map("completed_at")
  expiresAt         DateTime             @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  complaints        OrderComplaint[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String   @map("product_id")
  productName  String   @map("product_name")
  productImage String?  @map("product_image")
  productPrice Decimal  @map("product_price") @db.Decimal(12, 2)
  quantity     Int
  weight       Int      @default(0) // authoritative product weight snapshot in grams
  subtotal     Decimal  @db.Decimal(12, 2)
  sellerId     String   @map("seller_id")
  sellerName   String   @map("seller_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  changedBy  String?  @default("SYSTEM") @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("order_status_histories")
}

model OrderComplaint {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String    @map("customer_id")
  category    String
  description String    @db.VarChar(2000)
  status      String    @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, REJECTED
  adminNote   String?   @map("admin_note") @db.VarChar(1000)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([orderId, customerId])
  @@index([status, createdAt])
  @@map("order_complaints")
}

model OutboxEvent {
  id            String    @id
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventName     String    @map("event_name")
  routingKey    String    @map("routing_key")
  eventPayload  Json      @map("event_payload")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  lockToken     String?   @map("lock_token")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error") @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
