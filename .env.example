# ─── Infrastructure ───
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
RABBITMQ_USER=nexacommerce
RABBITMQ_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@localhost:5445/nexacommerce_db
TEST_DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@localhost:5445/nexacommerce_test_db
REDIS_URL=redis://:replace-with-a-long-random-password@localhost:6379
RABBITMQ_URL=amqp://nexacommerce:replace-with-a-long-random-password@localhost:5672
# API Gateway client identity for rate limiting. Leave empty when clients
# connect directly. Behind a load balancer set the hop count (e.g. 1) or the
# balancer's CIDRs (e.g. 10.0.0.0/8). `true` is rejected: it would let clients
# pick their own rate-limit key through X-Forwarded-For.
TRUST_PROXY=
# Order Service: an unfinalized checkout older than this is cancelled and its
# stock released (default 15 minutes).
CHECKOUT_FINALIZATION_TIMEOUT_MS=900000
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nexacommerce-event-stream
KAFKA_TOPIC_PREFIX=nexacommerce
KAFKA_REPLICATION_FACTOR=1
KAFKA_BRIDGE_RETRY_INTERVAL_MS=10000
KAFKA_BRIDGE_MAX_RETRIES=1000
ANALYTICS_DAILY_READ_MODEL=RABBITMQ
ANALYTICS_KAFKA_CUTOVER_WINDOW_DAYS=30
ANALYTICS_RABBITMQ_CONSUMER_ENABLED=true

# Optional transactional outbox tuning (defaults shown)
PAYMENT_OUTBOX_POLL_INTERVAL_MS=5000
PAYMENT_OUTBOX_BATCH_SIZE=50
PAYMENT_OUTBOX_LEASE_MS=60000
ORDER_OUTBOX_POLL_INTERVAL_MS=5000
ORDER_OUTBOX_BATCH_SIZE=50
ORDER_OUTBOX_LEASE_MS=60000
INVENTORY_OUTBOX_POLL_INTERVAL_MS=5000
INVENTORY_OUTBOX_BATCH_SIZE=50
INVENTORY_OUTBOX_LEASE_MS=60000
REVIEW_OUTBOX_POLL_INTERVAL_MS=5000
REVIEW_OUTBOX_BATCH_SIZE=50
REVIEW_OUTBOX_LEASE_MS=60000
SHIPPING_OUTBOX_POLL_INTERVAL_MS=5000
SHIPPING_OUTBOX_BATCH_SIZE=50
SHIPPING_OUTBOX_LEASE_MS=60000

# ─── JWT ───
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# ─── Browser security ───
CORS_ORIGINS=http://localhost:3020,http://localhost:3021,http://localhost:3022
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
JSON_BODY_LIMIT=1mb

# ─── Midtrans ───
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id
MIDTRANS_IS_PRODUCTION=false

# ─── SMTP (Email) ───
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM=noreply@nexacommerce.com
CUSTOMER_WEB_URL=http://localhost:3020

# ─── Service URLs (untuk internal communication, development) ───
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
# Example values only; replace every media setting before a deployment.
MEDIA_S3_BUCKET=nexacommerce-product-media
MEDIA_S3_REGION=ap-southeast-1
MEDIA_S3_ACCESS_KEY_ID=replace-with-object-storage-access-key
MEDIA_S3_SECRET_ACCESS_KEY=replace-with-object-storage-secret
# Leave blank for AWS S3; set an HTTPS S3-compatible endpoint (e.g. MinIO) otherwise.
MEDIA_S3_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
CART_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
INVENTORY_SERVICE_URL=http://localhost:3007
VOUCHER_SERVICE_URL=http://localhost:3008
SHIPPING_SERVICE_URL=http://localhost:3009
REVIEW_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
ANALYTICS_SERVICE_URL=http://localhost:3012
EVENT_STREAM_SERVICE_URL=http://localhost:3013

# ─── General ───
NODE_ENV=development
